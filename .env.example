# Neon connection string (Dashboard → Project → Connection Details → Pooled connection)
# Example: postgresql://<user>:<password>@<project-id>.pooler.<region>.neon.tech/<database>?sslmode=require
POSTGRES_URL=

# Optional: keep these if other tooling needs them (Prisma, CLI access, etc.)
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000/api/auth
